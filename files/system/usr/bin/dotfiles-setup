#!/usr/bin/env bash
set -euo pipefail

REPO="${1:-https://github.com/aeases/dotfiles}"
KEY="${2:+$(realpath -e "$2")}"
DEST="$HOME/dotfiles"

if [[ -e "$DEST" ]]; then
  echo "dotfiles-setup: $DEST already exists, nothing to do" >&2
  exit 1
fi

git clone --quiet "$REPO" "$DEST"

if git -C "$DEST" ls-files -z | git -C "$DEST" check-attr --stdin -z filter \
    | tr '\0' '\n' | grep -x git-crypt >/dev/null; then
  if ! git -C "$DEST" crypt unlock ${KEY:+"$KEY"}; then
    rm -rf "$DEST"
    echo "dotfiles-setup: could not unlock $REPO; run again with its key file:" >&2
    echo "  dotfiles-setup $REPO /path/to/git-crypt.key" >&2
    exit 1
  fi
fi

while IFS= read -r -d '' f; do
  rel="${f#/etc/skel/}"
  if [[ -f "$HOME/$rel" && ! -L "$HOME/$rel" ]] && cmp -s "$f" "$HOME/$rel"; then
    rm "$HOME/$rel"
  fi
done < <(find /etc/skel -type f -print0)

for f in .config/hypr/hyprland.lua .config/hypr/hyprland.conf; do
  if [[ -e "$DEST/$f" && -f "$HOME/$f" && ! -L "$HOME/$f" ]] \
      && grep -Eq '^(hl\.config\(\{ autogenerated = true \}\)|autogenerated = 1)' "$HOME/$f"; then
    rm "$HOME/$f"
  fi
done

cd "$DEST"
stow .
