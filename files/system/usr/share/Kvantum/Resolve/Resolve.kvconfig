[%General]
author=generated by ~/.scripts/resolve-qt-theme
comment=DaVinci Resolve look
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
center_normal_tabs=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=4
composite=true
translucent_windows=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
menu_separator_height=3
splitter_width=3
scroll_width=9
scroll_min_extent=36
scroll_arrows=false
transient_scrollbar=false
transient_groove=false
combo_as_lineedit=false
combo_menu=true
square_combo_button=false
inline_spin_indicators=true
inline_spin_separator=false
vertical_spin_indicators=true
slider_width=4
slider_handle_width=12
slider_handle_length=12
check_size=16
tickless_slider_handle_size=12
button_contents_shift=false
toolbar_icon_size=16
toolbar_item_spacing=1
toolbar_interior_spacing=2
layout_spacing=6
layout_margin=6
small_icon_size=16
large_icon_size=32
button_icon_size=16
animate_states=true
dark_titlebar=true
no_inactiveness=true
respect_DE=true
fill_rubberband=false
menubar_mouse_tracking=true
popup_blurring=false
scrollable_menu=true
submenu_overlap=0
submenu_delay=150
click_behavior=0
tree_branch_line=false
contrast=1.00
intensity=1.00
saturation=1.00

[GeneralColors]
window.color=#28282e
base.color=#28282e
alt.base.color=#2c2c32
button.color=#303035
light.color=#3a3a40
mid.light.color=#303035
dark.color=#090909
mid.color=#212126
shadow.color=#000000
highlight.color=#3f4550
inactive.highlight.color=#3f4550
tooltip.base.color=#17181a
text.color=#c4c4c8
window.text.color=#c4c4c8
button.text.color=#c4c4c8
disabled.text.color=#5c5c62
tooltip.text.color=#f0f0f0
highlight.text.color=#ffffff
link.color=#5fa8e8
link.visited.color=#a98fd8
progress.indicator.text.color=#ffffff
placeholder.text.color=#5c5c62

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=false
normal_default_pushbutton=false
iconless_pushbutton=false
iconless_menu=false
no_selection_tint=true
tint_on_mouseover=0
disabled_icon_opacity=50
lxqtmainmenu_iconsize=16
kcapacitybar_as_progressbar=true
middle_click_scroll=false
blur_only_active_window=false
centered_forms=false
single_top_toolbar=true
style_vertical_toolbars=false

[PanelButtonCommand]
